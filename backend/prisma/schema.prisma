generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model lead {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  firstName   String
  lastName    String
  email       String
  jobTitle    String?
  countryCode String?
  companyName String?
  message     String?
  emailVerified Boolean?
  phone       String?
  // Phone enrichment state: queued | searching | found | not_found | failed (null = never run).
  phoneEnrichmentStatus   String?
  // Provider being queried while searching, or the one that found the phone.
  phoneEnrichmentProvider String?
}

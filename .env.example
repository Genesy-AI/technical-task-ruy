# Per-instance settings. Copy to `.env` (git-ignored) in the repo root of each worktree and
# change the values so instances running side by side do not clash. Both the backend and the
# frontend dev server read this file; variables set in the shell take precedence.

# Port of the Vite dev server (and `vite preview`).
FRONTEND_PORT=5173

# Port of the Express API. The frontend calls http://localhost:${BACKEND_PORT}.
BACKEND_PORT=4000

# Optional: full API URL for the frontend, only if the backend is not on localhost:BACKEND_PORT.
# VITE_API_URL=http://localhost:4000

# Temporal. Instances can share one `temporal server start-dev`; give each one its own
# namespace so workers never pick up another instance's workflows.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=myQueue

# Phone enrichment providers. Keys default to the take-home's sandbox keys; set real ones here.
# PHONE_PROVIDERS_BASE_URL=https://api.enginy.ai/api/tmp
# ORION_CONNECT_API_KEY=
# ASTRA_DIALER_API_KEY=
# NIMBUS_LOOKUP_API_KEY=

# Optional per-provider rate limits, in requests per second across all workers. Unset = unlimited.
# Each provider's calls run on their own task queue (`<TEMPORAL_TASK_QUEUE>-phone-<provider>`).
# ORION_CONNECT_MAX_RPS=5
# ASTRA_DIALER_MAX_RPS=10
# NIMBUS_LOOKUP_MAX_RPS=2
